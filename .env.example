# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production on Vercel (recommended: Neon or Vercel Postgres, both have a
# generous free tier). Create a Postgres database, copy its connection
# string here, and change the `provider` in prisma/schema.prisma from
# "sqlite" to "postgresql". See README.md → "Deploying to Vercel".
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# UPI PAYMENT CONFIG (public — safe to expose to the browser)
# ─────────────────────────────────────────────────────────────
# Your real UPI ID, e.g. siddhant@okhdfcbank / 9876543210@ybl
NEXT_PUBLIC_UPI_ID="7850071585-1@nyes"
# The name that should show up in the payer's UPI app
NEXT_PUBLIC_UPI_NAME="Sidant"

# ─────────────────────────────────────────────────────────────
# DASHBOARD (secret — never exposed to the browser)
# ─────────────────────────────────────────────────────────────
# Sign-in credentials for your private /dashboard page. Already set to
# the ones you chose — change them anytime by editing these two lines.
DASHBOARD_ID="Sidhu@585"
DASHBOARD_PASSWORD="Vachi@Iloveu"
# Random long string used to sign the dashboard session cookie.
# Generate one with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET="iloveyouvachi#1@youaremyworld"

# ─────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────
# Full public URL of the deployed site (used for share links & OG tags).
# Locally this can stay as-is.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# TESTING (development only — see README "Testing the birthday flow")
# ─────────────────────────────────────────────────────────────
# Override "today" so you can preview countdown / live / thank-you states
# without waiting for 18 September. Format: YYYY-MM-DD. Leave unset to use
# the real date. NEVER set this in production.
# NEXT_PUBLIC_DEV_FAKE_DATE="2026-09-18"
